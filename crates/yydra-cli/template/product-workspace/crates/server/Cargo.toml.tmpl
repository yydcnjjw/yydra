[package]
name = "__PRODUCT_ID__-server"
version.workspace = true
edition.workspace = true
license.workspace = true

[[bin]]
name = "server"
path = "src/main.rs"

[[bin]]
name = "migrate"
path = "src/bin/migrate.rs"

[features]
# Controlled local validation only; the release server does not enable this feature.
auth-fixture = ["yydra-auth/test-provider"]

[dependencies]
yydra-auth.workspace = true
axum.workspace = true
product-application = { package = "__PRODUCT_ID__-application", path = "../application" }
product-persistence-postgres = { package = "__PRODUCT_ID__-persistence-postgres", path = "../persistence-postgres" }
product-transport-http = { package = "__PRODUCT_ID__-transport-http", path = "../transport-http" }
tokio.workspace = true
tower-http.workspace = true
tracing.workspace = true
tracing-subscriber.workspace = true
