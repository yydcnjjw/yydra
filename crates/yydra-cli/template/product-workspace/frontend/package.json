{
  "name": "__PRODUCT_ID__-frontend",
  "version": "0.1.0",
  "license": __PRODUCT_SOURCE_LICENSE_TOML__,
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "preweb": "node scripts/prepare-api.mjs",
    "preexport:h5": "node scripts/prepare-api.mjs",
    "pregenerate:android": "node scripts/prepare-api.mjs",
    "pretest": "node scripts/prepare-api.mjs",
    "pretypecheck": "node scripts/prepare-api.mjs",
    "pretest:e2e": "node scripts/prepare-api.mjs",
    "pretest:product-semantics": "node scripts/prepare-api.mjs",
    "web": "expo start --web",
    "export:h5": "expo export --clear --platform web --output-dir dist",
    "generate:android": "expo prebuild --platform android --clean --no-install",
    "format:check": "prettier --check app e2e modules src scripts app.json eslint.config.mjs metro.config.mjs orval.config.mjs package.json playwright.config.mts tsconfig.json tsconfig.native.json vitest.config.mts",
    "lint": "eslint --max-warnings=0 app e2e modules src scripts eslint.config.mjs metro.config.mjs orval.config.mjs playwright.config.mts vitest.config.mts",
    "test": "vitest run",
    "test:e2e": "node scripts/run-h5-e2e.mjs",
    "test:product-semantics": "node scripts/run-product-semantics.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.native.json"
  },
  "dependencies": {
    "@yydra/auth": "0.6.0-dev.1",
    "expo-crypto": "57.0.2",
    "expo-secure-store": "57.0.3",
    "expo-web-browser": "57.0.2",
    "@expo/metro-runtime": "57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.102.8",
    "@yydra/client-settings": "file:./modules/yydra-client-settings",
    "expo": "57.0.19",
    "expo-constants": "57.0.17",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.18",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "whatwg-fetch": "3.6.20",
    "@expo/config-plugins": "57.0.9",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "orval": "8.27.0",
    "prettier": "3.9.6",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
