{
  "components": {
    "schemas": {
      "FrameworkContractCreate": {
        "additionalProperties": false,
        "description": "Dedicated create shape retained separately from response and patch shapes.",
        "properties": {
          "exactAmount": {
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "type": "string"
          },
          "optionalNote": {
            "type": "string"
          }
        },
        "required": [
          "exactAmount"
        ],
        "type": "object"
      },
      "FrameworkContractPatch": {
        "additionalProperties": false,
        "description": "Dedicated patch shape; absent fields mean unchanged.",
        "properties": {
          "nullableNote": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "FrameworkContractProfile": {
        "additionalProperties": true,
        "description": "Cross-runtime wire conventions exercised by the generated client fixture.",
        "properties": {
          "exactAmount": {
            "description": "Exact decimal represented as a string.",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "type": "string"
          },
          "items": {
            "description": "Collections are arrays and never null.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "nullableNote": {
            "description": "Required and explicitly nullable response field.",
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "description": "RFC 3339 UTC timestamp.",
            "format": "date-time",
            "pattern": "Z$",
            "type": "string"
          },
          "opaqueId": {
            "description": "Opaque identifier; consumers must not infer storage semantics.",
            "type": "string"
          },
          "optionalNote": {
            "description": "Optional but non-null response field.",
            "type": "string"
          },
          "safeCount": {
            "description": "JavaScript-safe integer.",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "opaqueId",
          "occurredAt",
          "safeCount",
          "exactAmount",
          "items",
          "nullableNote"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details shared by declared public failures.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Yydra Product Public API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/framework-contract": {
      "get": {
        "operationId": "getFrameworkContractProfile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameworkContractProfile"
                }
              }
            },
            "description": "Wire-contract fixture"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Contract-valid server failure"
          }
        },
        "tags": [
          "framework"
        ]
      }
    }
  }
}
