{
  "components": {
    "schemas": {
      "ChangeReadingEntryStateRequest": {
        "additionalProperties": false,
        "properties": {
          "state": {
            "$ref": "#/components/schemas/ReadingQueueEntryState"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "CreateReadingEntryRequest": {
        "additionalProperties": false,
        "properties": {
          "sourceUrl": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "sourceUrl"
        ],
        "type": "object"
      },
      "FrameworkContractCreate": {
        "additionalProperties": false,
        "description": "Dedicated create shape retained separately from response and patch shapes.",
        "properties": {
          "exactAmount": {
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "type": "string"
          },
          "optionalNote": {
            "type": "string"
          }
        },
        "required": [
          "exactAmount"
        ],
        "type": "object"
      },
      "FrameworkContractPatch": {
        "additionalProperties": false,
        "description": "Dedicated patch shape; absent fields mean unchanged.",
        "properties": {
          "nullableNote": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "FrameworkContractProfile": {
        "additionalProperties": true,
        "description": "Cross-runtime wire conventions exercised by the generated client fixture.",
        "properties": {
          "exactAmount": {
            "description": "Exact decimal represented as a string.",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "type": "string"
          },
          "items": {
            "description": "Collections are arrays and never null.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "nullableNote": {
            "description": "Required and explicitly nullable response field.",
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "description": "RFC 3339 UTC timestamp.",
            "format": "date-time",
            "pattern": "Z$",
            "type": "string"
          },
          "opaqueId": {
            "description": "Opaque identifier; consumers must not infer storage semantics.",
            "type": "string"
          },
          "optionalNote": {
            "description": "Optional but non-null response field.",
            "type": "string"
          },
          "safeCount": {
            "description": "JavaScript-safe integer.",
            "format": "int32",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "opaqueId",
          "occurredAt",
          "safeCount",
          "exactAmount",
          "items",
          "nullableNote"
        ],
        "type": "object"
      },
      "FrameworkProtectedContract": {
        "additionalProperties": true,
        "properties": {
          "access": {
            "type": "string"
          }
        },
        "required": [
          "access"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": true,
        "description": "RFC 9457 Problem Details shared by declared public failures.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "ReadingQueueEntryResponse": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "description": "Opaque Product Domain identifier.",
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ReadingQueueEntryState"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "sourceUrl",
          "state"
        ],
        "type": "object"
      },
      "ReadingQueueEntryState": {
        "enum": [
          "queued",
          "completed"
        ],
        "type": "string"
      },
      "ReadingQueueResponse": {
        "additionalProperties": true,
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/ReadingQueueEntryResponse"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entries",
          "nextCursor"
        ],
        "type": "object"
      },
      "ReadingQueueSort": {
        "enum": [
          "oldest",
          "newest"
        ],
        "type": "string"
      },
      "ReadingQueueStatusFilter": {
        "enum": [
          "all",
          "queued",
          "completed"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Yydra Product Public API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/framework-auth-contract": {
      "get": {
        "operationId": "getFrameworkProtectedContract",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameworkProtectedContract"
                }
              }
            },
            "description": "Protected authentication-contract fixture"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing credentials"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Credentials lack access"
          }
        },
        "tags": [
          "framework"
        ]
      }
    },
    "/api/v1/framework-contract": {
      "get": {
        "operationId": "getFrameworkContractProfile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameworkContractProfile"
                }
              }
            },
            "description": "Wire-contract fixture"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Contract-valid server failure"
          }
        },
        "tags": [
          "framework"
        ]
      }
    },
    "/api/v1/reading-queue/entries": {
      "get": {
        "operationId": "listReadingQueueEntries",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ReadingQueueStatusFilter"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ReadingQueueSort"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingQueueResponse"
                }
              }
            },
            "description": "Reading queue"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid query or cursor"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Storage failure"
          }
        },
        "tags": [
          "readingQueue"
        ]
      },
      "post": {
        "operationId": "createReadingQueueEntry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReadingEntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingQueueEntryResponse"
                }
              }
            },
            "description": "Reading entry created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid JSON or unknown request field"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid reading entry"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Storage failure"
          }
        },
        "tags": [
          "readingQueue"
        ]
      }
    },
    "/api/v1/reading-queue/entries/{entry_id}": {
      "patch": {
        "operationId": "changeReadingQueueEntryState",
        "parameters": [
          {
            "description": "Opaque Product Domain identifier",
            "in": "path",
            "name": "entry_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeReadingEntryStateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingQueueEntryResponse"
                }
              }
            },
            "description": "Reading entry state changed"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid JSON or unknown request field"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Reading entry not found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Prohibited state transition"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid opaque identifier"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Storage failure"
          }
        },
        "tags": [
          "readingQueue"
        ]
      }
    }
  }
}
