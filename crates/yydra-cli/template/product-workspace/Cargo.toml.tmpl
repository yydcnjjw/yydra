# SPDX-License-Identifier: MIT OR Apache-2.0

[workspace]
members = [
  "crates/api-build",
  "crates/server",
  "crates/transport-http",
  "crates/application",
  "crates/domain",
  "crates/persistence-postgres",
]
exclude = [".yydra/build-support", ".yydra/auth-support"]
resolver = "3"

[workspace.package]
edition = "2024"
license = "MIT OR Apache-2.0"
version = "0.1.0"

[workspace.dependencies]
axum = "=0.8.9"
base64 = "=0.22.1"
hmac = "=0.13.0"
serde = { version = "=1.0.229", features = ["derive"] }
serde_json = "=1.0.151"
sha2 = { version = "=0.11.0", default-features = false }
sqlx = { version = "=0.8.6", default-features = false, features = ["derive", "macros", "migrate", "postgres", "runtime-tokio", "tls-rustls-ring-webpki"] }
tokio = { version = "=1.53.1", features = ["macros", "net", "rt-multi-thread", "signal", "sync", "time"] }
tower = { version = "=0.5.3", features = ["util"] }
tower-http = { version = "=0.7.1", features = ["cors", "trace"] }
tracing = "=0.1.44"
tracing-subscriber = { version = "=0.3.23", features = ["env-filter", "fmt"] }
utoipa = "=5.5.0"
utoipa-axum = "=0.2.0"

yydra-auth = { version = "=0.6.0", path = ".yydra/auth-support" }
