#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <tree-root>" >&2
  exit 64
fi

root=$(cd "$1" && pwd)
(
  cd "$root"
  find . \
    \( -path './.git' -o -path '*/target' -o -path '*/node_modules' \
       -o -path '*/dist' -o -path '*/.expo' -o -path '*/test-results' \
       -o -path '*/android' -o -path '*/ios' \) -prune \
    -o -type f -print0 \
    | sort -z \
    | while IFS= read -r -d '' path; do
        mode=$(stat -c '%a' "$path")
        digest=$(sha256sum "$path" | cut -d' ' -f1)
        printf '%s %s %s\n' "$mode" "$digest" "${path#./}"
      done \
    | sha256sum \
    | cut -d' ' -f1
)
